<?xml version="1.0" encoding="utf-8"?>
<!-- Niente backup nel cloud né trasferimento tra dispositivi: le credenziali sono cifrate con una
     chiave del Keystore che non lascia il telefono, e orario e impostazioni si sincronizzano con
     l'account BCW o con il backup dell'orario. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
